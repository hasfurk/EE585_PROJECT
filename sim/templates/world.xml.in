<mujoco model="${NAME}">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>
  <visual>
    <headlight active="0" ambient="0 0 0" diffuse="0 0 0" specular="0 0 0"/>
    <global offwidth="${OFFWIDTH}" offheight="${OFFHEIGHT}"/>
    <quality shadowsize="0"/>
  </visual>
  <asset>
    <texture name="surftex" type="2d" file="${TEXTURE}"/>
    <material name="surf" texture="surftex" texuniform="true" texrepeat="${TEXREPEAT}" rgba="1 1 1 1"/>
    <material name="mark" rgba="1 1 1 1" emission="1" specular="0"/>
  </asset>
  <worldbody>
    <light name="sun" directional="true" pos="0 0 5" dir="${LIGHT_DIR}" ambient="${LIGHT_AMBIENT}" diffuse="${LIGHT_DIFFUSE}" specular="0 0 0" castshadow="false"/>
    <geom name="floor" type="plane" size="30 30 0.1" pos="0 0 0" material="surf"/>
${GEOMS}
    <body name="tx" pos="0 0 0.05">
      <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
      <joint name="jx" type="slide" axis="1 0 0" damping="0"/>
      <body name="ty">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="jy" type="slide" axis="0 1 0" damping="0"/>
        <body name="base">
          <joint name="jyaw" type="hinge" axis="0 0 1" damping="0"/>
          <site name="imu" pos="0 0 0"/>
          <camera name="cam" pos="0.15 0 0.10" xyaxes="0 -1 0 0 0 1" fovy="${FOVY}" mode="fixed"/>
          <geom name="chassis" type="box" size="0.20 0.15 0.075" pos="0 0 0.05" mass="5" contype="0" conaffinity="0"/>
          <geom name="wheel_l" type="cylinder" size="0.05 0.01" pos="0 0.15 0" quat="0.7071067811865476 -0.7071067811865476 0 0" mass="0.01" contype="0" conaffinity="0"/>
          <geom name="wheel_r" type="cylinder" size="0.05 0.01" pos="0 -0.15 0" quat="0.7071067811865476 -0.7071067811865476 0 0" mass="0.01" contype="0" conaffinity="0"/>
          <geom name="caster" type="sphere" size="0.02" pos="-0.15 0 -0.03" mass="0.01" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>
  </worldbody>
  <sensor>
    <gyro name="gyro" site="imu" noise="0" cutoff="0"/>
    <accelerometer name="accel" site="imu" noise="0" cutoff="0"/>
  </sensor>
</mujoco>
